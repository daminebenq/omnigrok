{
  "name": "omnigrok",
  "account_id": "9d7461a47e946b6956278cb3ca1655da",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "OMNIGROK_KV",
      "id": "3d5f6c1bfb9249e388d8da850c390300"
    }
  ],
  "vars": {
    "ALLOWED_AUD": "99bc828324f91ffc920b127b08932068bb44a204ddcda215fcfe515618a25fbe",
    "ACCESS_TEAM_DOMAIN": "damine.cloudflareaccess.com"
  },
  "routes": [
    {
      "pattern": "omnigrok.damineweb.work/*",
      "zone_name": "damineweb.work"
    }
  ]
}
